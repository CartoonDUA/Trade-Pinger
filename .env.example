PORT=3000
POLL_INTERVAL_SECONDS=60

# Official X API v2 bearer token. Recent search access is required.
X_BEARER_TOKEN=
X_SOURCES=https://x.com/jdncrtr,https://x.com/PortalViciados

# Create a Telegram bot, add it to each monitored channel as an admin, then set its token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SOURCES=https://t.me/cyberleekario,https://t.me/+REPLACE_WITH_PRIVATE_INVITE
# The private channel cannot be read from an invite link. Add your bot and set the numeric chat ID.
TELEGRAM_PRIVATE_CHAT_ID=

# Twilio SMS credentials and E.164 phone numbers, such as +15551234567.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TO_NUMBER=
